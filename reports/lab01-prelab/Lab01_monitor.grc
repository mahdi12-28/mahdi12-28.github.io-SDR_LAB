    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 325e6
    step: 16e6
    stop: 3.8e9
    value: 945e6
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 32.0]
    rotation: 0
    state: enabled
- name: lo_shift
