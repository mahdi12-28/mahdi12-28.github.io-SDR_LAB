    rangeType: float
    start: -500e3
    step: 10e3
    stop: 500e3
    value: '0'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 184.0]
    rotation: 0
    state: enabled
- name: rec
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': 'False'
    gui_hint: ''
    label: Record I/Q
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 200.0]
    rotation: 0
    state: enabled
- name: rec_sec
  id: variable
  parameters:
    comment: ''
    value: min(4.0, 80e6/(8*samp_rate))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 20.0]
    rotation: 0
    state: enabled
