- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import math\nimport os\nimport time\n\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Record raw complex64\
      \ IQ samples on a record-checkbox rising edge.\"\"\"\n\n    def __init__(self,\
      \ team='Team-00', lab=1, fc=100e6, fs=2.6e6,\n                 gain=0.0, record=False,\
      \ max_seconds=5.0, folder='.'):\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='SDR Lab IQ Recorder',\n            in_sig=[np.complex64],\n\
      \            out_sig=None\n        )\n        # Matching names let GRC update\
      \ these values at runtime.\n        self.team = team\n        self.lab = lab\n\
      \        self.fc = fc\n        self.fs = fs\n        self.gain = gain\n    \
      \    self.record = record\n        self.max_seconds = max_seconds\n        self.folder\
      \ = folder\n\n        # No files or folders are created while GRC inspects the\
      \ block.\n        self._state = 'IDLE'\n        self._file = None\n        self._settings\
      \ = None\n        self._written = 0\n        self._limit = 0\n\n    def _begin(self,\
      \ settings):\n        fc, fs, gain = settings\n        duration = float(self.max_seconds)\n\
      \        if not all(math.isfinite(v) for v in settings):\n            raise\
      \ ValueError('fc, fs and gain must be finite numbers')\n        if fs <= 0 or\
      \ not math.isfinite(duration) or duration < 0:\n            raise ValueError('fs\
      \ must be positive; max_seconds must be finite and nonnegative')\n\n       \
      \ self._limit = math.floor(duration * fs)\n        stamp = time.strftime('%Y%m%dT%H%M%S')\n\
      \        filename = (\n            f'{self.team}_lab{int(self.lab):02d}_'\n\
      \            f'{int(round(fc))}_{int(round(fs))}_{gain:.1f}_{stamp}.cf32'\n\
      \        )\n        folder = os.path.expanduser(os.fspath(self.folder))\n  \
      \      os.makedirs(folder, exist_ok=True)\n        path = os.path.join(folder,\
      \ filename)\n        # Exclusive creation protects an existing recording with\
      \ the same name.\n        self._file = open(path, 'xb')\n        self._settings\
      \ = settings\n        self._written = 0\n        self._state = 'RECORDING'\n\
      \        print(f'[REC] start {filename}', flush=True)\n\n    def _finish(self,\
      \ reason, next_state):\n        if self._file is not None:\n            self._file.close()\n\
      \            self._file = None\n            seconds = self._written / self._settings[1]\n\
      \            print(\n                f'[REC] stop {self._written} samples =\
      \ '\n                f'{seconds:.2f} s ({reason})',\n                flush=True\n\
      \            )\n        self._state = next_state\n\n    def work(self, input_items,\
      \ output_items):\n        samples = input_items[0]\n        requested = bool(self.record)\n\
      \        settings = (float(self.fc), float(self.fs), float(self.gain))\n\n \
      \       if not requested:\n            self._finish('record unchecked', 'IDLE')\n\
      \            return len(samples)\n\n        if self._state == 'WAIT':\n    \
      \        return len(samples)\n\n        if self._state == 'IDLE':\n        \
      \    self._begin(settings)\n        elif settings != self._settings:\n     \
      \       self._finish('fc/fs/gain changed', 'WAIT')\n            return len(samples)\n\
      \n        # Trim the last chunk to reach the exact sample limit.\n        count\
      \ = min(len(samples), self._limit - self._written)\n        if count > 0:\n\
      \            np.asarray(samples[:count], dtype=np.complex64).tofile(self._file)\n\
      \            self._written += count\n\n        if self._written == self._limit:\n\
      \            self._finish('max_seconds reached', 'WAIT')\n\n        # A sink\
      \ consumes the entire input, including samples not recorded.\n        return\
      \ len(samples)\n\n    def stop(self):\n        self._finish('flowgraph stopped',\
      \ 'IDLE')\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_tune
    folder: '"recordings"'
    fs: samp_rate
    gain: rf_gain
    lab: '1'
    max_seconds: rec_sec
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
    team: team
  states:
    _io_cache: ('SDR Lab IQ Recorder', 'blk', [('team', "'Team-00'"), ('lab', '1'),
      ('fc', '100000000.0'), ('fs', '2600000.0'), ('gain', '0.0'), ('record', 'False'),
      ('max_seconds', '5.0'), ('folder', "'.'")], [('0', 'complex', 1)], [], 'Record
      raw complex64 IQ samples on a record-checkbox rising edge.', ['fc', 'folder',
      'fs', 'gain', 'lab', 'max_seconds', 'record', 'team'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 528.0]
    rotation: 0
    state: enabled
